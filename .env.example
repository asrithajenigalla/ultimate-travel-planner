# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# N8N Agentic AI Webhook Integration (Optional - app defaults to high-fidelity mock mode if unset)
VITE_N8N_PLAN_TRIP_WEBHOOK_URL="https://your-n8n-instance.com/webhook/travel-planner"
VITE_TRAVEL_AI_MODE="mock"
